pipeline {
    agent any

    environment {
        IMAGE_NAME = 'django-blog'
        IMAGE_TAG  = "${BUILD_NUMBER}"
    }

    stages {
        stage('Build Docker Image') {
            steps {
                echo "Building Docker image using Dockerfile..."
                sh "docker build -f Dockerfile -t ${IMAGE_NAME}:${IMAGE_TAG} -t ${IMAGE_NAME}:latest ."
            }
        }
    }
}